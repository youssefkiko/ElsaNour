# Copy this file to .env.local and fill in the values.
# Never commit .env.local (it is ignored by git). On Vercel, add the same names in
# Project Settings > Environment Variables.

# Supabase project URL. Supabase dashboard > Project Settings > Data API > Project URL.
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (safe in the browser, used for the admin login in Phase 4).
# Supabase dashboard > Project Settings > API Keys > Publishable key (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key: SERVER ONLY, never in the browser, never in the chat or in git.
# Used to save orders. Supabase dashboard > Project Settings > API Keys > Secret keys
# (starts with sb_secret_).
SUPABASE_SECRET_KEY=

# Email of the ONE admin account (Supabase dashboard > Authentication > Users).
# Only this account can open /admin. Several emails can be separated by commas.
ADMIN_EMAIL=

# Public address of the site (share previews, sitemap, Google). Real domain at launch.
NEXT_PUBLIC_SITE_URL=https://elsa-nour-store.vercel.app

# Meta (Facebook / Instagram) Pixel ID from Meta Events Manager (a number, not secret).
# Empty = no Pixel and no cookie notice.
NEXT_PUBLIC_META_PIXEL_ID=
